rules_version = '2';

// NOTE: money/fulfillment writes (orders, licenses, products.purchases) happen
// server-side with the Admin SDK, which bypasses these rules. Keep in sync with
// NEXT_PUBLIC_ADMIN_EMAILS (.env.example / Vercel).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['developerlife69@gmail.com']
        && request.auth.token.email_verified == true;
    }

    // Public catalog + settings (read-only for everyone)
    match /products/{productId} {
      allow read: if true;
      // Purchases count is maintained server-side on verified payment.
      allow write: if isAdmin();
    }

    match /content/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form: authenticated users only, with field size limits to prevent abuse.
    match /contacts/{documentId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["name", "email", "subject", "message", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if false;
    }

    // Financial records are written exclusively via the Admin SDK (server).
    // Reads are restricted to admins — customer-facing lookup goes through
    // authenticated server routes that scope by email.
    match /orders/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /licenses/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // SaaSWaitlist projects: public read so landing/directory pages can populate.
    // Admin writes require verified email (isAdmin).
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SaaSWaitlist waitlist: public read so waitlistCount can be displayed.
    // Public create (email capture), admin-only update/delete.
    match /waitlist/{waitlistId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Default: deny all other access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
