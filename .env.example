# Firebase client SDK (required for real data)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary unsigned uploads (admin image gallery)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Comma-separated allowlist for the admin UI and Nexus API calls.
# Firestore rules also enforce this list server-side.
NEXT_PUBLIC_ADMIN_EMAILS=developerlife69@gmail.com

# Nexus integration (defaults to the live deployment
# https://nexusprods.vercel.app — set these only to override, e.g. to
# http://localhost:3001 for a local Nexus instance).
NEXT_PUBLIC_NEXUS_URL=
NEXT_PUBLIC_NEXUS_API_URL=

# Canonical site URL used by sitemap/robots and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=

# Local development only. Set to "true" to point the client SDK at the local
# Firebase emulators (Auth on :9099, Firestore on :8099). The value is inlined
# at build time, so it has to be set before starting the dev server.
# NEXT_PUBLIC_FIREBASE_EMULATOR=false
